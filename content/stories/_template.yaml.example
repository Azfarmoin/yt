# Copy to content/stories/<id>.yaml (no leading underscore). Stories are HUMAN-AUTHORED: the engine never invents story content.
# Every story is forced to `needs_review`; a person must check each claim against the cited sources before approving.
id: example-id
title: Short title
theme: patience
hook: One-sentence hook (first 3 seconds)
sources:
  - "Name of book/collection, volume/page or hadith number"
lines:
  - label: "Context"
    ur: "اردو متن"
    en: "English text"
    ar: ""            # optional; only genuine, verified Arabic quotations

